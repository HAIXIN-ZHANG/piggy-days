generator client {
  provider     = "prisma-client"
  output       = "../src/generated/client"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskCategory {
  SHOPPING
  COOKING
  CITY_OUTING
  CHORE
  DATE
  OTHER
}

enum TaskStatus {
  TODO
  COMPLETED
}

enum RetailerCode {
  COLES
  WOOLWORTHS
  ALDI
}

enum FarmResource {
  FEED
  SEEDS
  COINS
}

model Task {
  id          String       @id @default(cuid())
  title       String
  category    TaskCategory @default(OTHER)
  description String?
  place       String?
  plannedDate DateTime?
  status      TaskStatus   @default(TODO)
  completedAt DateTime?
  checkIn     CheckIn?
  farmEvents  FarmEvent[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status])
  @@index([plannedDate])
}

model CheckIn {
  id        String   @id @default(cuid())
  taskId    String   @unique
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  photoUrl  String?
  note      String?
  costCents Int?
  place     String?
  createdAt DateTime @default(now())
}

model FarmEvent {
  id        String       @id @default(cuid())
  resource  FarmResource
  amount    Int
  reason    String
  taskId    String?
  task      Task?        @relation(fields: [taskId], references: [id], onDelete: SetNull)
  reviewId  String?
  review    ReviewCard?  @relation(fields: [reviewId], references: [id], onDelete: SetNull)
  createdAt DateTime     @default(now())

  @@index([createdAt])
}

model ShoppingList {
  id        String         @id @default(cuid())
  title     String         @default("Shopping list")
  items     ShoppingItem[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model ShoppingItem {
  id                     String        @id @default(cuid())
  listId                 String
  list                   ShoppingList  @relation(fields: [listId], references: [id], onDelete: Cascade)
  productId              String?
  product                Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  name                   String
  quantity               Int           @default(1)
  isBought               Boolean       @default(false)
  estimatedPriceCents    Int?
  recommendedRetailer    RetailerCode?
  recommendedRetailerNote String?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  @@index([listId])
}

model Retailer {
  id          String          @id @default(cuid())
  code        RetailerCode    @unique
  displayName String
  products    Product[]
  prices      PriceSnapshot[]
  deals       Deal[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model Product {
  id                  String          @id @default(cuid())
  retailerId          String
  retailer            Retailer        @relation(fields: [retailerId], references: [id], onDelete: Cascade)
  name                String
  brand               String?
  category            String?
  sizeLabel           String?
  currentPriceCents   Int?
  unitPriceCents      Int?
  unitPriceLabel      String?
  isDeal              Boolean         @default(false)
  priceSnapshots      PriceSnapshot[]
  deals               Deal[]
  shoppingItems       ShoppingItem[]
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([name])
  @@index([retailerId])
}

model PriceSnapshot {
  id         String   @id @default(cuid())
  retailerId String
  retailer   Retailer @relation(fields: [retailerId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  priceCents Int
  unitPriceCents Int?
  capturedAt DateTime @default(now())

  @@index([productId, capturedAt])
  @@index([retailerId, capturedAt])
}

model Deal {
  id             String       @id @default(cuid())
  retailerId     String
  retailer       Retailer     @relation(fields: [retailerId], references: [id], onDelete: Cascade)
  productId      String
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  title          String
  originalCents  Int?
  dealCents      Int
  startsAt       DateTime?
  endsAt         DateTime?
  sourceUrl      String?
  createdAt      DateTime     @default(now())

  @@index([retailerId])
  @@index([productId])
  @@index([endsAt])
}

model ReviewCard {
  id                    String      @id @default(cuid())
  rangeStart            DateTime
  rangeEnd              DateTime
  summary               String
  completedTaskCount    Int         @default(0)
  placesVisited         Json        @default("[]")
  moneySpentCents       Int         @default(0)
  grocerySavingsCents   Int         @default(0)
  thingsWorthRepeating  Json        @default("[]")
  suggestedNextTask     String?
  farmEvents            FarmEvent[]
  createdAt             DateTime    @default(now())

  @@index([rangeStart, rangeEnd])
}
